<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sec_server" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="text"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="@string/hint_address"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_port"
                android:inputType="number"
                android:maxLength="5"
                android:singleLine="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/uuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_uuid"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:typeface="monospace" />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sec_transport" />

        <Spinner
            android:id="@+id/network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/networks" />

        <LinearLayout
            android:id="@+id/ws_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_path"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/ws_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_host"
                android:inputType="textUri"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sec_security" />

        <Spinner
            android:id="@+id/security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/securities" />

        <EditText
            android:id="@+id/sni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sni"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/tls_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/insecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/insecure" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/insecure_hint"
                android:textAppearance="?android:attr/textAppearanceSmall" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reality_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/pbk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_pbk"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:typeface="monospace" />

            <EditText
                android:id="@+id/sid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_sid"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:typeface="monospace" />

            <EditText
                android:id="@+id/fp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_fp"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/spx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_spx"
                android:inputType="textUri"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/holo_red_light"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
